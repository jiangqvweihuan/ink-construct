static func tags_for(id: String) -> Array:
	return (TAGS.get(id, []) as Array).duplicate()


static func tag_group(tag: String) -> String:
	var info: Dictionary = TAG_INFO.get(tag, {})
	return str(info.get("group", ""))


static func tag_entries() -> Array:
	var out: Array = []
	for tag in TAG_ORDER:
		var tag_name := str(tag)
		var info: Dictionary = TAG_INFO[tag_name]
		var members: Array = []
		for id in TAG_ACTOR_ORDER:
			if tags_for(str(id)).has(tag_name):
				members.append(str(id))
		var item := _e("tag_" + tag_name, "tag", "codex", str(info["group"]), tag_name,
			str(info["summary"]), info["rules"], [], ["TAGS"])
		item["member_ids"] = members
		out.append(item)
	return out


