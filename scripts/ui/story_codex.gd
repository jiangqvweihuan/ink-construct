static func entries() -> Array:
	return [
		# ---------- 卷一 · 水墨总纲 ----------
		_e("world_ink", VOLUME_WORLD, "天地一砚", "旧山河、残页与命墨的总纲",
			"水墨世界不是一场可以随手醒来的梦。旧世的人生已经真实发生，入卷后的出手、承情与选择也同样留下结果。", [
				_s("墨并非幻术的外衣", [
					"旧山河广阔而久远，有临江戏班、西岭剑庐、天姥剑碑，也有并非同一王朝、同一岁月的宫城与神军。那些地方不能硬排在一张年表上，却被一种共同的底色贯穿：人的意志会在世界上留下墨迹。剑痕、曲谱、香火账、机关榫眼，都是墨迹的不同形状。",
					"所谓「墨」不是单纯颜料，而是经历凝成之后仍能回应选择的存在。浓处保存执念，淡处保存余韵，飞白保存没有说完的话。修仙者称之为灵性，习武者称之为意气，墨堂旧籍则统一记作「命墨」；称呼不同，指向的都是一个人为何仍是自己的那条线索。",
				]),
				_s("残页留住的不是幻影", [
					"残卷收束山河破碎后游离的命墨，将某些人、某些地点与某段未完之事写成残页。入卷者保有旧世经历，却不是被完整复活到原来的街巷：他们醒在残页构成的山谷里，身体由墨稳固成行卷墨身，伤口、疲惫与死亡都会真实作用于此身。",
					"这并不意味着旧世可以轻易改写。冷红绫救过的孩子不会因她入卷而重新陷于火中，苏挽音弹过的《黍离》也不会被另一段故事抹掉。残页能够改变的是尚未结束的纠缠：封线逼谁重复哪个动作，谁还能不能在下一笔作出不同回答。",
				]),
				_s("留白与续写的边界", [
					"留白不是空无，而是尚未被强制落款的部分。一个被写得密不透风的人只会重复旧戏；留下一线空白，他才可能停刀、收曲、承认旧友，或者仍旧选择为敌。六化身所争取的不是人人改邪归正，而是让选择不再由封线代作。",
					"因此，入卷后的胜负有结果，却没有万能的结局。拆除封轴可以松开一处关隘，击败一名守关者可以打断当前判决，却不保证旧世复生、旧国重兴或所有创伤痊愈。故事承认每一次真实努力，也承认努力有其边界。",
				]),
			], [], [], ["roster:forms", "roster:enemies", "roster:bosses"]),
		_e("world_valley", VOLUME_WORLD, "残卷山谷", "一座山谷与不断折换的山河",
			"残卷山谷由许多残页叠成。外院、中庭、墨堂与深处是稳定的行进骨架，房内山河却会随命墨与守关者折景。", [
				_s("山谷的四重地势", [
					"初入山谷，先见外院。这里纸纹浅、封线疏，最容易辨认墨身、敌我与出口；越过外院便入中庭，残页彼此压叠，旧街、山门与雨亭的痕迹会在同一座院落里露出边角。再往里是墨堂，梁柱与卷架仍在，昔日封卷手法也保存得最完整。",
					"三关之后抵达的「墨堂深处」不是一间只属于某位首领的固定殿堂，而是总封轴露出之处。总封轴与当前残页相应，才把来客送进相应的关核。冒险中走完三关后进入一处深处；无尽则每层重新穿过三小关，再进入当层深处。",
				]),
				_s("折景：同一关核，五类山河", [
					"折景是残页接管空间的过程。墨霆的命墨占住关核时，深处展开云海山巅的云坪；焚鼎相应时，暮色群峰与湖畔石板路压过原有地面；武车把废墟校场的长街推入山谷；碎岳相应时显出白昼山门；鸣钟则使阴暗古寺与钟前石场覆盖堂基。",
					"这些景象不是五个人共同驻扎在墨堂，也不是墨堂临时修建了五种布景。它们是被封轴牵来的不同残页记录，各有自己的旧世来历。离开当前残页或解开当前封轴后，折景便会淡去，另一局或无尽另一层才可能换成不同记录。",
				]),
				_s("行路之人如何利用折景", [
					"折景虽会改变地形，却保留可以被理解的纸理。云坪的雷痕绕不开引雷机关，长街的兵迹连着车厢旧令，山门借契总有抵押落笔，古寺神谕必须经过鸣钟之身。六化身不是盲猜破关，而是从眼前的墨理倒推关核。",
					"房内敌手与路途细节仍有变化，故事不为每次遭遇写死固定座次。不变的是因果：外院教人辨认封线，中庭让人寻找轴踪，墨堂保存封卷证据，深处才显露当前首领。知道这一层，便不会把随机相逢误读成所有人早有约定。",
				]),
			], ["c009", "c015a1", "c001", "c008", "c032"], [], ["route:three_gates", "route:boss_room", "boss_scene:c009", "boss_scene:c015a1", "boss_scene:c001", "boss_scene:c008", "boss_scene:c032"]),
		_e("world_motang", VOLUME_WORLD, "墨堂封卷", "救崩坏之念如何成了困人之术",
			"墨堂曾以封卷阻止残页崩散，后来却把「不再变化」当成唯一救赎。它是当前封线的最大源头，却不是所有旧世灾难的唯一幕后黑手。", [
				_s("从补卷到封卷", [
					"墨堂起初只是搜集残页、修补墨理的工坊与学舍。那时有人替断谱补间奏，替断碑留空白，也替无处可去的命墨寻一页栖身。封线原本像装订线，只用来防止一页在修补完成前散开；封轴则记录一页的开合，不应替页中人物决定言行。",
					"崩坏加剧后，堂中主事者越来越害怕变化。他们发现把命墨固定在最浓烈的一幕，残页便能长久不碎，于是修卷逐渐变成封卷。唱到一半的戏永远唱不完，守到最后的钟永远停不下来，逃难者也永远保持逃难。稳定得以维持，活着的人却失去下一笔。",
				]),
				_s("封卷理念为何仍有追随者", [
					"封卷并非毫无理由的酷刑。对经历过山河崩散的人而言，永远停在痛处似乎也好过彻底消失；有些残页确实因封线而保住了姓名与地形。墨堂借此宣称，只有众生命墨都由堂中统一收束，世界才不会再度脱墨。",
					"六化身反对的不是保存，而是剥夺后续选择。他们会利用旧档寻找封轴，也会保住仍有价值的纸理；要拆的是强制落款的那一道线，而不是把整个山谷一把火烧成空白。若只求毁掉所有墨迹，受困者也会随残页一同散失，那与墨堂以保存之名困人一样，是替别人决定结局。",
				]),
				_s("墨堂之外，仍有各自旧难", [
					"临江戏班的血债与火、旧宫城破、悬空寺的借契、神军溃败和炎骨炼鼎，各有旧世因果，不能全部倒推成墨堂策划。青魇剑主是明确遭墨堂夺亭的受害者，墨霆也与墨堂直接相关；其他人则可能只是死后或事发后被残卷收束。",
					"分清这一点，闯关才不会沦为寻找唯一恶人。六化身既要对付仍在执行封卷的力量，也要面对不服从墨堂、却同样会伤人的执念。焚鼎的怒焰、碎岳的账与鸣钟的神谕不能靠打倒一名堂主便自动消失。",
				]),
			], ["c037", "c009"], [], ["lore:c037", "lore:c009", "lore:c015a1", "lore:c008", "lore:c032"]),
		_e("world_forms", VOLUME_WORLD, "行卷六身", "化身、换形与执卷留白",
			"入卷者所执的是残卷中尚未被写死的留白，不是第七名英雄，也不是站在故事外随意摆布众人的作者。六名化身则是各自完整的命墨。", [
				_s("为何需要行卷墨身", [
					"残页封线会排斥没有被它收录的外来意志。留白之所以能进入，是因为它不属于任何一段已经完成的旧史，可以在页缘承住一笔新选择。但留白没有自己的筋骨与招式，必须与愿意响应的命墨相契，才能凝成可行走、可受伤的行卷墨身。",
					"冷红绫、定山、白疏影、洛惊鸿、苏挽音与将去未还不是被制造出来的躯壳。他们各有旧世、性格与目标，只是因为当前命墨与留白的契合方式不同，显形的时机有先后。资料全部开放供人阅读，不等于每一命墨在实际旅程开始时都已完成契合。",
				]),
				_s("换形不是夺舍", [
					"换形是命墨接续显形：当前一人把行卷之职交给另一人，旧形散回页缘，新形沿自身招式与习气站稳。继承的是共同走过的路线、彼此作过的约定与已经看见的证据，不是把一个人的记忆灌进另一个人的意识。",
					"因此，六人能够在不同显形之间保留对同伴的认识，却不会因此共享每段私密旧世。将去未还学会他人招式，是观察与命墨相契后的重演；苏挽音的弦、定山的棒、洛惊鸿的听剑仍各有不可替代的来历。",
				]),
				_s("执卷者能做什么", [
					"执卷留白可以在战斗中作出进退选择，可以在房与房之间接受残页所凝的新笔意，也可以在墨身散失后重新落笔。但它不能凭一句话让死者复生，不能替角色宣布放下旧恨，更不能把五名首领从各自残页里召来排队受审。",
					"旅程因而不是「作者收拾角色」，而是留白与众生命墨共同争取续写权。每一次胜利都由具体的人完成，每一次相识也都有来由；执卷者是同行条件之一，不是六人情谊与选择的替代者。",
				]),
			], ["c021", "c013", "c023", "z000", "z002", "z003"], [], ["roster:forms", "skill:z003:2", "lore:c021", "lore:z002"]),
		_e("world_purpose", VOLUME_WORLD, "为何向深处去", "拆封线、解封轴与夺回下一笔",
			"闯关的目的不是杀光山谷里所有会动的人，而是沿封线找到封轴，解除当前关核对命墨的强制落款，让续写命运的权利回到众生自己手中。", [
				_s("三关各有要做的事", [
					"外院先破最外层行禁，辨认哪些攻击来自自身执念、哪些动作被封线强迫；中庭循页缘寻找轴踪，拼出当前残页与总封轴的关系；墨堂则从旧档和封卷手法里确认拆解次序。若跳过这些步骤直接伤人，封线很可能换一副身体重新收紧。",
					"抵达深处后，目标是解开当前关核。守关者往往正是封轴维持自身形状的关键，因而战斗不可避免；但出手不是把对方从故事里抹除，而是打断眼前这一轮强制循环。有时要毁去机关，有时要压下怒焰，有时只是让旧令终于没有下一声。",
				]),
				_s("先辨敌我，再谈杀伐", [
					"刀客、蛮兵与刺客会主动伤人，不能因为他们也被命墨困住就放弃抵抗；双镰、青笠与青魇剑主的力量更稳定，又守着关键路径，交锋更难免。六人之约要求先辨认、再出手、胜后查看封线，避免把「受苦」误当成「无罪」，也避免把「为敌」误当成「该被抹除」。",
					"击败敌人给出的通行结果，是这一路不再被其当前形态阻挡。某些执念仍会回到残页深处，某些旧创也无法靠一场战斗痊愈。承认这一点不会削弱胜利，反而让每次拆封都有明确而可信的意义。",
				]),
				_s("终点不是替众生写结局", [
					"普通冒险解开一名首领所系的关核便算走完本次封轴；无归难度连续牵出两名不同首领，需要依次处理两道关核；无尽则在每层折景中继续深入。三者都不是一局把五名首领全部消灭，也不是杀到最后便自动修好整个旧山河。",
					"六化身真正想夺回的，是下一笔可以由本人落下的权利。冷红绫想让别人不必照着火场谢幕，定山想让守护不再成为抵押，白疏影想让异路也能生长，洛惊鸿想留住无名者的落款，苏挽音想让人从曲中自行醒来，将去未还想让旧招与旧友都有再见面的一天。目的相同，答案不必相同。",
				]),
			], ["c021", "c013", "c023", "z000", "z002", "z003"], [], ["route:three_gates", "route:boss_room", "route:double_boss", "route:endless"]),

		# ---------- 卷二 · 化身与相逢 ----------
		_e("form_c021", VOLUME_FORMS, "冷红绫 · 火后不谢幕", "绯刃化身的第一段行卷记",
			"她从只接无人敢接的活，走到不许封卷替别人写结局；与定山的初遇，是这段改变真正开始的地方。", [
				_s("旧世承下来的那一拍", [
					"临江戏班失火前，冷红绫已经把水袖裁成短绫，把舞步改成双匕。她穿过浓烟救出最后一个孩子，自己却再没找到回去的路。此后蒙面入行，她只接无人敢接的活，出手仍照旧拍，仿佛每一刺都在替未能唱完的那折戏补一个收势。",
					"她与双镰确曾同班，却一个记火，一个记血；两种记忆不必完全重合。她知道夜游神的双镰如何随锣鼓开合，不知道那场台下血债的全部名单。残卷保留这些空白，使她后来重逢时既有辨认旧人的依据，也必须面对自己并不知晓全貌的事实。",
				]),
				_s("醒卷：先遇见一根不肯退的棒", [
					"她醒在外院一片被红墨浸透的纸廊里，第一反应是沿最短封线直取轴心。定山却拦在廊口，先替几个被墨线拴住脚踝的山民解开行禁。她嫌他误时，他问她若廊后还有人是否也一概不管，两人几乎先动了手。",
					"真正让他们停下争执的是封线回卷。冷红绫以「流光度影」穿过将合的纸缝，本可独自离开，却回身割断最后一道线；定山则扛住落梁，把这条退路撑到所有人都走完。两人没有立刻互诉旧世，只交换姓名与下一步信号，信任先从可靠而来。",
				]),
				_s("当前目标与未解之结", [
					"冷红绫逐渐明白，自己过去所谓「受邀看舞的人一个也不能留」，是在怕旧戏再次把旁人卷进来。入卷后她仍敢冒险，却开始给同行者留下红绫结作为回报，不再把独自赴死当成唯一干净的收场。",
					"面对双镰，她不会因为同班旧缘便放弃交战，也不会把对方当成必须铲除的怪物。她要做的是打断那折永远等不到谢幕的《血月绽花》，让彼此都能停下旧锣鼓。至于旧债如何清算，应在封线之外，由真正经历的人自己回答。",
				]),
			], ["c021", "c013", "c018"], ["r_c021_c013", "r_c021_c018"], ["lore:c021", "lore:c018", "skill:c021:0", "passive:c021:1"]),
		_e("form_c013", VOLUME_FORMS, "定山 · 先把生路留下", "从破庙断梁到六人之约",
			"定山的守护不是替别人决定该去哪里，而是先让选择有立足之地。他在入卷后结识同伴，也在碎岳与鸣钟身上看见守护的另外两种答案。", [
				_s("旧世的一根狼牙棒", [
					"定山年少在破庙挑水劈柴，不爱诵经，最爱替农户赶野猪。矿场废铁打成的狼牙棒与三年面壁，一外一内，练出他不肯倒的骨头。山洪冲寺时，他独自扛住断梁让香客先走，「定山」由此不是法号般的高名，而是一条确实被人走过的生路。",
					"入卷没有让他变成无所不知的圣僧。他仍不擅讲长篇道理，仍可能先挥棒后追问；只是「圣僧」被动所体现的不受外物牵心，使他能在魔音、借契与神谕中保留自己的判断。他的坚定需要事实校正，而不是永远天然正确。",
				]),
				_s("从冷红绫到苏挽音", [
					"与冷红绫初遇后，定山学会了尊重别人选择的冒险，而不是把保护变成阻拦。他在墨林中替白疏影撑住退路，在洛惊鸿守碑时先听完问剑，逐渐接受六人可以有截然不同的行进方式。",
					"苏挽音初醒引发魔音误会时，定山没有因自己不受癫狂便断言曲子无害。他听完一曲，也要求她亲手解除误伤者的状态。这个先辨心、再验结果的过程，让两人建立起比单纯施恩更稳的信任，也为后来六人约定「先辨敌我」立下样子。",
				]),
				_s("两面镜子，而非两段旧交", [
					"碎岳把庇佑改作借契，要求受护者抵押最倚仗的本领；定山认为那样做等于先抽走人的立足之地。两人在白昼山门是理念对手，不是破庙与悬空寺之间被补出的旧友。碎岳利用封卷局势收账，也不等于他向墨堂称臣。",
					"鸣钟则站在另一种守护尽头：她为旧主战意守钟，诸神却越过她直接写下结局。定山与她交战，要解除当前神谕判决，不是逼她承认千年守护全错。战胜之后，他仍愿意留一口钟给愿意守的人，只是钟不能再替所有人报出同一个时刻。",
				]),
			], ["c013", "c021", "z002", "c008", "c032"], ["r_c021_c013", "r_c013_z002", "r_c013_c008", "r_c013_c032"], ["lore:c013", "lore:c008", "lore:c032", "passive:c013:0", "skill:c013:2"]),
		_e("form_c023", VOLUME_FORMS, "白疏影 · 墨梅自开", "不被正统承认，也有资格生长",
			"失控的墨枝让她与冷红绫、定山相遇；一次不问师承的问剑，又把她引向洛惊鸿。她的目标从证明剑路，转为替异路守住生长空间。", [
				_s("废剑与折梅的旧路", [
					"白疏影生在西岭剑庐，见得最多的是钝铁回炉。她从废剑堆里捡出软剑，缠上折梅，练成似鞭非鞭的路数；同门笑她剑不正，她便在下山夜以一枝梅花连败七场。多年之后，她仍把赢来的剑埋回老梅根下，不争剑魁，也不以门徒多少证明传承。",
					"梅香中的苦毒不是她生来嗜杀，而是风雪剑路上练就的手段。她会在出手前拂去花瓣，也会把每次真正命中的账留到终局再算。这样的克制使她入卷后格外敏感：若剑枝开始不认自己的呼吸，问题未必在心性，可能是残页正在替她落款。",
				]),
				_s("墨林相逢：不当新怪物", [
					"她醒卷时，软剑与梅枝被错写成一片不断收紧的毒墨林。冷红绫最先赶到，本可沿林外绕开，却发现枝势每次追着白疏影的呼吸改变，判断这不是普通守关陷阱。定山随后以重棒撑住倾倒的墨干，给她留下看见封线的余地。",
					"白疏影没有让两人替自己斩尽墨枝，而是亲自削去那道把「折梅」误写成「折人」的封笔。墨林散后，她向二人报上姓名，没有报连败七场的战绩。冷红绫记得这份亲手收回剑路的决定，定山则邀请她同行一程，三人的相识由此有事件、有选择，也有各自保留的边界。",
				]),
				_s("问剑之后，所见之敌", [
					"她循清剑声找到洛惊鸿，以一鞭一刺请对方听剑。洛惊鸿没有问西岭正统，只说出两种攻势同属一段呼吸，这让她第一次无需胜负便获得承认。此后她愿意替洛惊鸿守无字残碑，也愿意在六人轮替时用梅枝标出接力的位置。",
					"青笠使她看见另一种被正统压住的剑：第三层已会回答，旧禁却不许它赢。青魇剑主则更险，他的规矩正被魔剑逐寸吞食。白疏影与他们入卷后才相识，不能补成同门；她所能做的是认剑、断禁、斩当前剑契，让对方自己的回答有机会留下。",
				]),
			], ["c023", "c021", "c013", "z000", "c012", "c037"], ["r_c021_c023", "r_c023_z000", "r_c023_c012", "r_c023_c037"], ["lore:c023", "lore:c012", "lore:c037", "attack:c023:0", "skill:c023:0", "passive:c023:0"]),
		_e("form_z000", VOLUME_FORMS, "洛惊鸿 · 无字处有落款", "听剑、认人与守住无名者",
			"她由白疏影的一枝软剑进入众人之行，以听剑辨认命墨自己的声音；她想守住的不是正统剑名，而是无名者也能落下的那一笔。", [
				_s("天姥山的听字诀", [
					"洛惊鸿曾守一座无人朝拜的剑碑，晨扫落叶，暮读残铭。师父只教一个「听」字，她用了十年把松涛听成剑谱。所谓一剑惊鸿，并非声势越大越好，而是听完之后那一剑足够准确；收剑很轻，是不愿惊动不需要被胜负卷进去的人。",
					"她不立门派，也不替谁正名，这使她面对残卷时天然警惕「统一题名」。墨堂把不同人的命墨写成同一类守关者，青笠旧阁把剑仆限定在第三层之前，都是先给名分再准人出剑。洛惊鸿要问的恰是去掉喝令之后，剑还剩什么声音。",
				]),
				_s("残碑之前，白疏影来问", [
					"入卷后，她先在一座无字残碑前醒来。碑不是天姥旧碑的原样搬运，而是山谷借她守碑经历折出的页缘。白疏影从墨林循声而来，没有报师承，只把软剑递到碑前。洛惊鸿听出鞭击与前刺间那份不被剑庐承认仍自成节律的呼吸，便侧身让她进入碑前留白。",
					"两人随后找到冷红绫与定山。洛惊鸿一度以「松间问鹤」拦住冷红绫的独自突进，这一剑不伤人而只问归路；冷红绫答应用红绫结回报之后，她才收剑。她由此加入，不是因为众人同属剑门，而是因为这群人愿意听完彼此再出手。",
				]),
				_s("青笠之答与无名者之约", [
					"青笠的问答双剑让她听见两个互相冲突的呼吸：一个已经敢赢，一个仍怕阁主降罪。她以四段「骤雨听剑」打断外加的禁声，却不替青笠宣布第三层之后还有什么。入卷认剑可以发生在敌人之间，承认对方剑意也不要求立刻成为朋友。",
					"在六人中，她尤其坚持将去未还重演他人招式时必须保留原主姓名。她自己守无字碑，并非崇尚无名，而是知道名字应该由本人决定写或不写。闯关到深处，她要解的是强制落款；碑上若最终仍无字，只要那是持碑者自己的选择，也同样值得守住。",
				]),
			], ["z000", "c023", "c021", "c012", "z003"], ["r_c023_z000", "r_c021_z000", "r_z000_c012", "r_z000_z003"], ["lore:z000", "lore:c012", "attack:z000:0", "attack:z000:2", "skill:z000:3"]),
		_e("form_z002", VOLUME_FORMS, "苏挽音 · 曲终人自醒", "从安定人心到归还选择",
			"一场魔音误会让她与定山建立信任，一段刻意留白又引来将去未还。她不再替权贵安定人心，也不以救世之名替被定格者作答。", [
				_s("《黍离》不是权贵的安魂曲", [
					"苏挽音曾是乱世宫中的琵琶乐师。城破之夜，帝王携金帛西逃，却命她留下奏曲安定人心；她独坐空殿，把《黍离》从黄昏弹到天明。弦上所存不是对权位的忠诚，而是百姓不肯屈服的恨。宫门再开，她抱琵琶走入人海，自此只称「绛弦」。",
					"她能以摄心使人回头，也能以魔音引出不敢承认的恨，因此最清楚「我这是为你好」可能多么危险。入卷后，她仍爱惜弦、仍会在月下校音，却再不肯用一曲替所有人决定何为安宁。她要让人听见自己，然后自行选择。",
				]),
				_s("误会必须以行动解开", [
					"她醒在中庭一座无声乐棚，醒来便以弦音抵住墨兵。附近刀客受「余音入魔」影响彼此攻击，冷红绫与定山赶到时，最先看见的正是她站在纷乱中心。她没有要求众人立刻相信自己的来历，定山也没有因自身免受外物侵扰便替她担保。",
					"定山放下狼牙棒，请她把曲子弹完；曲至末音，苏挽音主动收去癫狂，让尚有自己意识的刀客停刀，让仍被封线驱赶者露出脚下墨痕。事实辨明后，定山才向她让路。她的信任来自承担曲声造成的后果，而不是靠一段悲惨旧史免除质问。",
				]),
				_s("静默引来的第六人", [
					"后来她被一道封线压住回音，故意在曲中留下不自然的静默。残页茶棚里的将去未还听出那里本该有动静，撑伞寻来，以时停替她争出拨弦的空隙。两人脱险后先分一碗热汤，再交换姓名与旧业，轻快往来并不削弱这份救命之情。",
					"她与鸣钟没有旧世私交，也不因一个奏弦、一个守钟就被写成同源神女。面对鸣钟时，弦音只能帮助辨认神谕节拍；要解除判决仍需实际破关。她的当前目标是让被定格者从曲中、钟声或任何外来声音里醒来，而不是成为新的、更温柔的发令者。",
				]),
			], ["z002", "c013", "z003", "c032"], ["r_c013_z002", "r_z002_z003", "r_z002_c032"], ["lore:z002", "lore:z003", "attack:z002:3", "skill:z002:2", "skill:z002:3"]),
		_e("form_z003", VOLUME_FORMS, "将去未还 · 旧伞还遮新雨", "药商、卖伞人与第六份命墨",
			"他由苏挽音的曲中留白加入同行，以旧伞和机关手法接上墨霆；学招、说笑与认真记住别人的伤口，在他身上并不矛盾。", [
				_s("许多活计，同一个名字", [
					"将去未还做过雪岭脚下的药商，后来卖伞、说书、押镖，也在客栈送过客、替漏刻匠看过摊。活计换得多，嘴快、手快、学招快却始终没变。输给他的人会发现得意招式在他的影子里重演，世人称他「影殇」，他却仍忙着下一顿热饭与下一场热闹。",
					"他的轻松不是对旧难无动于衷。长夜明火来自荒寺一锅暖人的热汤，万籁停晷来自七日听水的耐性，舜华斩则来自不再碰落花枝的练习。残卷把这些看似零散的活计收成一人，正说明他并非没有来历的游侠剪影。",
				]),
				_s("曲中留白与茶棚旧伞", [
					"入卷后，他在残页茶棚修伞，听见苏挽音的曲子忽然缺了一处应有回音。旁人或许只当曲终，他却凭说书人听场子的经验判断有人被抹去动静，便撑伞寻去。封线合拢前，他以时停抢出一线空隙，苏挽音则以弦音标出真正出口。",
					"两人找到其余四人后，他没有立刻把每个人都当老友。白疏影纠正他学鞭不收花，洛惊鸿要求他报出招式原主，冷红绫明确不许拿戏班说笑，定山与他约好时停只用于救命拆封。第六份命墨是在这些具体磨合里被接纳，而非一出场便天然属于队伍。",
				]),
				_s("云坪识伞，不识雷夜全貌", [
					"卖伞旧业让他认得墨霆的修伞手法：伞骨怎样换、机簧怎样藏、引雷针为何装在看似多余的位置。云坪巨兽身上出现同样的榫合时，他能确认那位机关师就在其中，也能向同伴解释哪些部件不该贸然斩断。",
					"但旧识有边界。他不知道墨霆为何给怕雷的自己留下这样一件作品，也不知道雷夜之后两种意识如何纠缠。当前目标因此是拆开巨兽与封轴的强制连接，尽量保住机关师自己的回应，而不是喊一声旧友便期待恢复如初。战后若只剩一颗能认出的螺丝，也算比全无落款多一线续写余地。",
				]),
			], ["z003", "z002", "c009", "c021", "c023", "z000", "c013"], ["r_z002_z003", "r_z003_c009", "r_z000_z003", "r_c013_z003"], ["lore:z003", "lore:c009", "skill:z003:2", "skill:z003:3", "skill:z003:4"]),
		_e("form_covenant", VOLUME_FORMS, "六人之约", "轮番显形，共同保留走过的路",
			"六人不是旧世故交全员重逢，也不是没有分歧的同道雕像。他们在入卷后逐次相逢，以可执行的约定处理换形、战斗、异议与救援。", [
				_s("相识有先后，会合有凭证", [
					"冷红绫与定山先在外院并肩，随后在失控墨林遇见白疏影；白疏影以问剑引来洛惊鸿；定山在魔音误会后认下苏挽音；苏挽音曲中的留白最终引来将去未还。这条顺序是入卷后的相逢骨架，不代表每次新旅程都机械重演同一幕，而是共同记忆如何建立的源头。",
					"他们会合时没有盟主选拔，也没有同门拜帖。每个人拿出一件能证明自己选择的凭证：一条回返的红绫结、一根让出生路的棒、一枝亲手收回的梅、一道听完再出的剑、一曲主动解开的魔音、一把在静默里撑来的伞。六份凭证合成最初的约定。",
				]),
				_s("轮番显形，不共享一切", [
					"行卷时只有当前命墨显形，其余人留在页缘接应。换形后，众人保留共同路线、公开约定与交接时留下的信息；个人的私密旧世仍由本人决定是否说出。这样既解释为何不同化身能够继续同一趟闯关，也避免把六人写成共用一个意识的躯壳。",
					"他们约定交接必须留下三样信息：当前封线的位置、尚未辨明的敌我、下一条可以撤退的路。将去未还负责把复杂线索说得能记住，洛惊鸿负责听出遗漏，苏挽音以曲声给轮替定时，白疏影与冷红绫标记路径，定山确认最慢的人也有立足处。分工可随战况变化，不是僵硬军职。",
				]),
				_s("意见不合时怎样走", [
					"六人允许争论，却不允许以救人名义替别人封口。若有人要独自深入，必须留下回报与撤退信号；若多数人判断当前执念已无法靠交谈停下，可以先战斗，但胜后必须检查封线，不能把人一倒了之。遇到无法确认的残页，先保住无辜者与退路，再争解释。",
					"他们的共同目标不是把敌人全变成朋友。双镰可能仍不原谅旧班旧事，青笠可能继续独自远行，鸣钟也可能仍选择守钟。六人之约只保证不再由墨堂、神谕或任何一名同伴替他们落款。能同路便同路，不能同路也留一条不必互相吞噬的边界。",
				]),
			], ["c021", "c013", "c023", "z000", "z002", "z003"], ["r_c021_c013", "r_c021_c023", "r_c023_z000", "r_c013_z002", "r_z002_z003", "r_c021_z000", "r_c013_c023", "r_c013_z000", "r_c023_z002", "r_z000_z003", "r_c021_z002", "r_c021_z003", "r_c013_z003", "r_c023_z003"], ["roster:forms", "lore:c021", "lore:c013", "lore:c023", "lore:z000", "lore:z002", "lore:z003"]),

		# ---------- 卷三 · 敌我与关隘 ----------
		_e("foes_mobs", VOLUME_FOES, "山道三类旧业", "刀客、蛮兵与刺客为何向来客出手",
			"杂兵不是统一训练、统一听令的士卒。他们把各自的求生旧业带入残卷，又在封线推动下把来客视作猎物、目标或必须跨过的障碍。", [
				_s("刀客：下一口活路", [
					"刀客是山野间最常见的亡命人，一柄卷刃长刀便是全部家当。旧世里死后连名字也无人记得，入卷后，残页放大的是「再撑一场便可能有活路」的惯性。他会主动攻击，不因遭遇可怜就失去危险性。",
					"冷红绫辨认他乱刃上的求生墨痕，是为了决定拆封与阻敌的先后，而不是替他免除旧罪。击倒之后，若脚下封线仍把他拖回同一处山道，下一局再次相遇便不是荒诞复活，而是当前残页尚未彻底解开。",
				]),
				_s("蛮兵：不肯停下的追逐", [
					"蛮族力士身高逾丈，巨斧拖地，一旦认准猎物便一步步赶上。旧业里的耐力与威慑在残页中成了不肯停步的执念，他不需要墨堂每日发令，也会把闯入山道者认作新猎物。",
					"定山以同样不退的脚步截住他，意在给旁人争出绕开封线的空隙。胜负只结束当前追逐；蛮兵是否愿意在留白里放下猎物身份，是另一件不能由胜利者代写的事。",
				]),
				_s("刺客：从椅后延续的沉默", [
					"刺客曾是城门边的剃头匠，听遍秘密却不接话。第一次收钱割舌之后，铺子没了，椅上换了另一种客人，他仍从椅后下刀。入卷后，隐蔽、听息与背后出手自然成为攻击方式，而非某座军营统一教出的阵法。",
					"将去未还能从细微动静里识破他，却不把沉默浪漫化。敌人有来历不等于行为可被原谅；众人阻挡的是正在发生的杀伤，拆的是逼其反复回到旧业的封线。三类杂兵因此各有动机，也会因残页变化出现在不同路段，没有写死的固定房间座次。",
				]),
			], ["c016", "c017", "c035", "c021", "c013", "z003"], ["r_c021_c016", "r_c013_c017", "r_z003_c035"], ["lore:c016", "lore:c017", "lore:c035", "roster:enemies"]),
		_e("elite_c018", VOLUME_FOES, "双镰 · 血月尚未谢幕", "临江同班重逢，不等于旧债一笔勾销",
			"双镰仍是没有等到谢幕的夜游神伶人。冷红绫认得他的锣鼓，却不掌握他全部旧难；入卷重逢给两人一个停下旧拍的机会，而不是立即和解。", [
				_s("同一座戏班，两种灾难记录", [
					"双镰专演夜游神，一双银镰在灯影里交错如月。班主说戏最要紧是懂得收，可他压轴的《血月绽花》从没等到谢幕；戏班欠下血债，那夜台下比台上先见红。此后他仍按旧锣鼓点出手，再无人替他敲收场一声。",
					"冷红绫所记则是失火、浓烟与送孩子出后门。两份记录可以属于同一座临江戏班的不同侧面，却不能随意合并成一场由墨堂导演的大火。双镰的花神搭档也不在现有资料中署名，故事不会为凑关系便指定为冷红绫。",
				]),
				_s("入卷重逢先以招式认人", [
					"重逢时，冷红绫先听见的是比脚步更早的锣鼓点，随后才看见银镰。双镰也能从她的旋身认出旧班舞步，却仍把她纳入必须完成的压轴场面。两人都知道对方是谁，不等于都知道对方这些年如何活过来，更不等于愿意放下眼前这一折。",
					"冷红绫选择先接住旧拍，再在不伤人的空隙割断催促开场的封线。她的绯刃能定住一瞬，却无法替双镰决定何时谢幕；定山守住台口，避免其他受困命墨继续被卷入。战斗的目标由此清楚：停住这场被强令重复的开演。",
				]),
				_s("胜后只留下可以续写的空白", [
					"双镰被击败后，旧债不会自动清算，冷红绫也无权代表整个戏班道歉或原谅。他可能仍怨她只记住火，可能仍要完成自己的收场；这些都可以留到封线之外。六人只确认他不再被强迫对每个来客开演。",
					"这段关系之所以重要，不在于把精英变成队友，而在于证明旧识也可能仍须兵刃相见。理解来路、承认危险、给对方留下选择，三件事必须同时成立。",
				]),
			], ["c018", "c021", "c013"], ["r_c021_c018"], ["lore:c018", "lore:c021", "skill:c021:2"]),
		_e("elite_c012", VOLUME_FOES, "青笠 · 问答双剑", "第三层剑意之后，只能由自己回答",
			"青笠是摆脱听雨阁禁限的剑仆，不是任何一名化身的旧同门。白疏影与洛惊鸿在入卷后认剑，帮助他切断外加禁声，而不代他作答。", [
				_s("阁主不许仆先懂剑", [
					"青笠原在听雨阁替名家喂招，只有斗笠，没有题名。阁主说剑意不可过三，免得仆比主先懂剑；阁毁那夜，他第一次使完第三层，雨里站起另一个自己，替他斩断那句「不许赢」。从此他带双剑远行，一名「问」，一名「答」。",
					"这段旧世与白疏影的西岭剑庐、洛惊鸿的天姥守碑各自独立。三人可以对剑路产生理解，却没有共同师父或同门年表。强行合并门派，反而会抹掉青笠最重要的处境：不是没有高明剑理，而是有人不许他拥有自己的答案。",
				]),
				_s("入卷后的认剑之战", [
					"白疏影先以软剑引开「问」，发现剑锋每将越过某种分寸便会被无形禁声拉回。洛惊鸿随后听出两个呼吸，一个要赢，一个怕赢。她们没有把青笠当成走火入魔，也没有因敬佩剑意便站在原地挨打；认剑与应战同时进行。",
					"洛惊鸿以连续剑声截断旧阁禁令在残页里的回音，白疏影用梅枝缠住被逼出的多余一式。青笠能否以「答」自行收剑，是这场战斗真正留下的空白。六人只拆外加禁限，不宣称他从此归入六人之行。",
				]),
				_s("精英之名来自稳定执念", [
					"青笠比杂兵更难对付，是因为双剑、第三层剑意与旧禁共同形成稳定结构，命墨在残页中更不易散开。这不是他持有更高军衔，也不是墨堂把他提拔为统领。",
					"击败青笠打开当前道路，也暂时打断旧禁对他的支配。若另一份残页再次把他写成只能喂招的剑仆，仍须重新辨认与拆解；一次认剑不会自动变成整个世界的永久通关凭证。",
				]),
			], ["c012", "c023", "z000"], ["r_c023_c012", "r_z000_c012"], ["lore:c012", "lore:c023", "lore:z000", "attack:z000:2", "attack:c023:0"]),
		_e("elite_c037", VOLUME_FOES, "青魇剑主 · 亭主与魔剑", "墨堂夺亭的受害者，仍须阻止的执剑人",
			"青魇剑主的亭子明确毁于墨堂夺取，魔剑又沿他的规矩吞食旧主。交战目标是斩断当前剑契，而非把他简化为该被除掉的邪物。", [
				_s("青亭旧主如何成了青魇", [
					"他原是渡头青亭主人，青衣迎客，剑只用来裁茶、削笺、替迷路人斩荆棘。墨堂夺亭那夜，他拔出亭基下祖辈封存的绿色魔剑；剑保住了亭，也顺着他的规矩一寸寸吃掉旧主。青魇不是魔剑的名字，而是亭主留在人间的最后一场噩梦。",
					"如今他仍见客先施礼，三剑不差分毫，生命将尽时还会以剑代楹，再向魔物赊一命。这种维持礼数与不断反噬并存的状态，使战斗不能止于第一次倒下；但机制上的再起不等于无限复活，也不证明他自愿为墨堂效忠。",
				]),
				_s("六人怎样判断该斩哪里", [
					"白疏影先注意到他的剑招被礼数分成过分整齐的三段，洛惊鸿则听出亭基与魔剑之间有另一道缓慢呼吸。众人由此把目标从「杀死亭主」改为「断开当前剑契」：冷红绫找线，定山挡住再起时的冲击，白疏影与洛惊鸿分别牵制三剑。",
					"这不是一套保证无伤的仪式，而是实际战斗中逐渐确认的方向。青魇剑主仍会主动杀人，六人不会因同情便让他继续守住渡口。先阻止，再断契，是保护来客与保留旧主意识必须同时完成的两件事。",
				]),
				_s("斩断一次，不承诺还原旧亭", [
					"胜利解除的是当前残页中魔剑与封线的相互借力。青亭可能依旧残破，亭主也未必能恢复成昔日待客之人；故事不拿一场胜利承诺旧世重建。",
					"墨堂在此负有明确加害责任，却不能由此推断所有首领都是其部下。青魇剑主的经历恰说明封卷之外还有夺取、恐惧与错误抉择，这些因果需要分别面对。",
				]),
			], ["c037", "c023", "z000", "c021", "c013"], ["r_c023_c037"], ["lore:c037", "roster:enemies", "lore:c023"]),
		_e("enemy_echelon", VOLUME_FOES, "关隘的三种重量", "杂兵、精英与首领不是军衔",
			"三类敌手的区别在命墨稳定度、执念结构与所系关隘，而不在一套统一官阶。首领属于不同残页，随机抽取与无归连战也不等于全员同堂。", [
				_s("杂兵：重复旧业的游离命墨", [
					"刀客、蛮兵与刺客保有清楚的旧业，却较易被当前残页环境推着行动。他们的攻击主要来自求生、追逐或隐秘杀人的惯性，封线让这些惯性不断指向新来客。人数与路段可以变化，不能据此画出一张人人固定值守的军图。",
					"他们会被真正击伤、击倒，也会在某次封线未解时再次出现。危险与可怜并存，但任何来历都不使当前攻击失去效力。六人先保住行路，再处理墨线，是最基本的分寸。",
				]),
				_s("精英：能自洽循环的执念", [
					"双镰的锣鼓、青笠的问答、青魇剑主的礼数与魔剑，都形成比杂兵更稳定的自我循环。他们在残页里拥有更清晰的个人招式和更难打断的命墨结构，所以成为精英，而不是因为被任命成杂兵上级。",
					"精英与化身可能旧识、可能入卷初遇，也可能只有当前敌对。双镰只与冷红绫有同班依据，青笠与两名剑修是入卷认剑，青魇剑主则主要由青亭事件连接。关系必须逐条成立，不能因为同属图鉴一页便互相熟识。",
				]),
				_s("首领：各自牵住一处关核", [
					"墨霆的机关与雷、焚鼎的炎骨、武车的旧令、碎岳的借契、鸣钟的神谕，都能支撑一整份残页折景，因而在深处成为首领。他们不是统一军队里的五名将军，更不是全部住在墨堂等候点名。",
					"普通冒险从当前可相应的残页中牵出一名首领；无归连续牵出两名不同首领，第二道关核在第一道解开后才显现；无尽每层再作抽取，并避免相邻层连续相应同一首领。于是同一局不会遇齐五首领，各首领章所述经历是不同残页记录，不是共同出场的一场大会战。",
				]),
			], ["c016", "c017", "c035", "c018", "c012", "c037", "c009", "c015a1", "c001", "c008", "c032"], ["r_c021_c018", "r_c023_c012", "r_c023_c037", "r_z003_c009", "r_c021_c015a1", "r_c013_c001", "r_c013_c008", "r_c013_c032"], ["roster:enemies", "roster:bosses", "route:boss_room", "route:double_boss", "route:endless"]),
		_e("boss_c009", VOLUME_FOES, "墨霆 · 云坪引雷", "机关师与巨兽不是同一个声音",
			"墨霆与墨堂直接相关，将去未还却只凭旧日修伞手法认得他。云坪之战要区分机关师、巨兽与封轴三者的意志。", [
				_s("怕雷的人为何装上引雷针", [
					"墨霆原是墨堂里最会修伞的机关师，怕雷，却偏给巨兽装了引雷针。一个雷夜后，他与作品一起醒来：巨兽把他认作唯一会拧螺丝的人，他则再也想不起为什么要离开。如今他守在云坪，见客先看脚下，寻找能替换旧心的螺丝。",
					"这段旧史留下两个不能混同的意识：机关师懂手艺，也曾想离开；巨兽依赖他的维护，又把依赖变成不允许任何人接近的占有。封轴利用二者互相需要，让云坪雷夜不断重临。简单摧毁一切会同时伤及被扣住的机关师，单纯叙旧又无法让巨兽停止攻击。",
				]),
				_s("伞骨榫眼里的旧识证据", [
					"将去未还卖伞时见过墨霆修伞，认得其换骨与紧簧习惯。他在巨兽某些连接处看见相同手法，才敢告诉同伴：这不是凭空生成的雷兽，里面确实牵着一个旧识。这个判断有实际证据，不靠所有角色突然互通背景资料。",
					"他将可用伞绳与剑势牵住细小封线，其他人避开引雷节奏、阻断巨兽对机关师的强制维护要求。墨霆是否回应、能回应多少，取决于当前意识还剩多少留白；旧交只是打开一问的机会，不是跳过战斗的口令。",
				]),
				_s("云坪解轴的结果", [
					"战斗胜利意味着本次引雷与封轴连接被切断，云坪折景不再强制重演雷夜。巨兽可能沉寂，机关师可能只留下一点能辨认旧伞的反应；故事不承诺二者立即完整分离或恢复旧世肉身。",
					"其他首领不会因此同时受伤，也不会在云坪战后排队现身。若普通冒险此处已解当前关核，本次旅程便完成；无归的第二道封轴属于另一份残页，无尽下一层也会重新折景。",
				]),
			], ["c009", "z003", "c021", "c013"], ["r_z003_c009"], ["lore:c009", "lore:z003", "boss_scene:c009", "route:boss_room"]),
		_e("boss_c015a1", VOLUME_FOES, "焚鼎 · 湖畔炎骨", "独立炎骨残页与一轮被压下的怒焰",
			"焚鼎曾以自身为鼎炼火，鼎裂后仍把余焰锁在骨里。他与临江戏班失火无关，战斗只压下本次怒焰并解开当前封轴，不宣称彻底治愈。", [
				_s("以身为鼎留下的余焰", [
					"紫焰锁链缠身的巨汉曾以自身为鼎炼火，鼎裂后仍把余焰锁在骨里。他不再追逐无休止的厮杀，每次出手后会退开蓄势；可侵入对手体内的怒焰，会替他把战斗继续烧下去。锁链既像束缚，也像他防止余焰彻底失控的最后手段。",
					"这份炎骨残页独立于临江戏班、墨堂机关与古寺神军。残卷可以在崩坏后收束他，却不能因此把炼鼎写成墨堂统一安排。理解独立来历，才能避免见到火焰便认定所有旧难同源。",
				]),
				_s("冷红绫面对的不是旧火场", [
					"湖畔石板路与暮色群峰折出关核时，冷红绫确实会被紫焰唤起旧记忆。她最初试图封死每一处焰口，随后发现那样做只会让骨中余焰更急地回冲。将去未还提醒她辨认锁链的受力，定山则为众人留出退开蓄势的位置。",
					"她最终把目标改为切断封轴对怒焰的反复催动，而非命令焚鼎立刻忘记炼鼎。战斗仍要正面承受攻击，也要避免把每次退开误读成怯战；他退一步是在蓄势，怒焰离体后仍会继续作用，都是当前残页真实规则的一部分。",
				]),
				_s("灭火不是唯一救赎", [
					"封轴解开后，本轮向外蔓延的怒焰被压下，湖畔折景可以退去。焚鼎骨里是否仍有火、是否愿意继续以锁链自控，不由六人替他宣告痊愈。若另一层残页再次相应，他仍可能以未解执念出现。",
					"这一战对冷红绫的意义，是学会区分眼前火与旧日火。她能够救人而不把每个被火困住的人都当成戏班亡灵，也能够承认有些余焰只能先控制，不能靠一句放下便消失。",
				]),
			], ["c015a1", "c021", "z003", "c013"], ["r_c021_c015a1"], ["lore:c015a1", "lore:c021", "boss_scene:c015a1", "route:endless"]),
		_e("boss_c001", VOLUME_FOES, "武车 · 长街旧令", "车头不退，车厢里仍有人听令",
			"武车与墨堂直接相关，但车厢墨兵并非一名将领的同一队亲兵。长街之战要同时处理冲撞与不断被旧令征来的命墨。", [
				_s("只会驶向校场尽头", [
					"双马拖曳的钢铁战车不懂退让，只会撞向校场尽头，再掉头放出一轮新的追兵。车厢里封着仍在听令的墨兵，他们有的只剩起身动作，有的还保存旧世某个听令瞬间；武车把这些不同命墨纳入一套不断重复的出征流程。",
					"墨堂利用武车执行封卷，使它与堂中旧制直接相关；但被征入车厢的人不因此全是墨堂士卒。旧令能够跨残页收束听令者，所以沿途召唤可以有不同来源，不必与六化身任何一人的旧国、旧寺或门派绑定。",
				]),
				_s("定山先挡出一条侧路", [
					"废墟校场折入深处后，长街看似只能迎车硬撞。定山却发现车厢每次放兵前，街边封签都会先亮。他以重棒挡出侧路，让冷红绫与白疏影穿过兵列去拆封签；洛惊鸿听车轮转向，苏挽音以曲声扰乱统一节拍，将去未还把握停令的空隙。",
					"这不是六人必须同时显形的特殊演出，而是他们在行卷交接中共同使用的情报。实际战斗仍由当前化身完成，其他人的作用通过路线标记、约定与对旧令的辨认体现，不改变游戏内轮番显形的规则。",
				]),
				_s("旧令终止于哪一声", [
					"解除关核不是把每节车厢都打回空白，而是让「掉头之后必须再放一轮追兵」这条命令失去封轴支撑。武车可以停下，车厢命墨也可能散回各自残页；他们是否还有别的未了之事，不在这一战里被统一决定。",
					"普通冒险若抽到武车，解开这一处便完成当前深处；无归连战中的第二名首领来自另一封轴，不能被写成武车车厢里藏着的援军。无尽再遇则是另一层旧令重新聚合，不是上一场战斗被宣布无效。",
				]),
			], ["c001", "c013", "c021", "c023", "z000", "z002", "z003"], ["r_c013_c001"], ["lore:c001", "boss_scene:c001", "route:double_boss", "route:endless"]),
		_e("boss_c008", VOLUME_FOES, "碎岳 · 山门收账", "借契僧不是定山旧友，也不是墨堂忠臣",
			"碎岳把封卷视作可以收账的局势，借契逻辑与定山的守护正面冲突。他有自己的账法与选择，不因利用墨堂便归顺墨堂。", [
				_s("功德簿为什么变成借契", [
					"碎岳原是悬空寺香账僧，专管把香火钱与所求之事逐笔记清。他发现功德簿上满是求寿、求财、求逢凶化吉，却无人肯写自己该做什么，索性把簿子改成借契：庇佑可以领，须拿最倚仗的本领作抵押。",
					"住持逐他出山，他反手把多年烂账捆在佛像背上拖走，半面山墙随之塌下，「碎岳」由此得名。如今他仍逢人先盘账，对方倒下是抵押到期，自己倒下便认作坏账核销。这个体系残酷却自洽，不是临时替墨堂站台的说辞。",
				]),
				_s("封卷局势中的独立收账人", [
					"白昼山门折景展开时，碎岳会把封线当作抵押凭证：既然残页把人的本领固定下来，他便认为这笔抵押比旧世更好执行。他可能利用墨堂封卷维持账目，也可能反过来挡住墨堂中想修改账目的手；合作与冲突都服从他的借契，而非统一阵营命令。",
					"定山与他入卷初遇，争论从「护人是否该先收走立身本领」开始。碎岳认为定山无限承担终究也是一笔烂账，定山则指出把选择抵押掉之后，被护者根本无账可认。两人没有旧世同寺、同门或旧友关系。",
				]),
				_s("解轴不是替他做坏账", [
					"六人要拆的是把当前众人本领强制写成抵押的关核。碎岳可以承认自己被击败是一笔坏账，却不能据此抹掉所有借契；六人也不以他的账法宣布他从此一无所有。战斗结束只停止当前强制收取。",
					"定山在这一战里确认，守护若不能让人保住自己的选择与本领，便可能变成另一种占有。这份领悟来自入卷后的对照，不需要补写旧交来提高分量。碎岳也仍是独立残页首领，不会与鸣钟共同组成佛门双将。",
				]),
			], ["c008", "c013"], ["r_c013_c008"], ["lore:c008", "lore:c013", "boss_scene:c008", "route:boss_room"]),
		_e("boss_c032", VOLUME_FOES, "鸣钟 · 古寺神骸", "旧主战意与诸神判决不是同一回事",
			"鸣钟来自诸神与神军旧史，独立于墨堂、悬空寺和旧宫。她要守的早已不是神谕，却仍会被神谕越过血肉写下结局。", [
				_s("没有卸甲的女武神", [
					"鸣钟曾是战神座前女武神，也是神军溃败后唯一没有卸甲的人。诸神把战神遗骨铸成无舌之钟，命她永远镇守；她拆下钟架骨槌磨成双斧，从此既守钟，也替钟开口。年月太久，她忘了本名，只答「鸣钟」。",
					"她守的早不是神谕，而是钟里不肯熄灭的旧主战意。可诸神仍能借神骸越过她的意愿，直接给出判决。于是守钟既出于她自己，也被外力利用；这两种因素必须同时看见，才能理解为何她既是关隘，也是被封住的人。",
				]),
				_s("定山听见另一种不退", [
