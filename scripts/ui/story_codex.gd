		"id": id, "volume": volume, "title": title, "subtitle": subtitle,
		"summary": summary, "sections": sections, "cast": cast,
		"relation_ids": relation_ids, "canon_refs": canon_refs,
	}


static func _r(id: String, a: String, b: String, origin: String, label: String,
