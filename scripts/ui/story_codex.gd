	return [
		_r("r_c021_c018", "c021", "c018", "旧世确有关系", "临江同班 · 台上台下", -20,
			"冷红绫与双镰旧世同属临江戏班：她以水袖与双匕压轴，他专演夜游神。二人认得彼此的锣鼓与身段，却没有证据把双镰那位花神搭档指定为冷红绫。戏班血夜与失火是同一劫难留下的不同记录，入卷重逢只让他们确认对方也被困住，并不自动消解旧债。"),
		_r("r_z003_c009", "z003", "c009", "旧世确有关系", "伞下旧识 · 只识其技", -19,
			"将去未还卖伞时见过墨霆修伞，认得他换骨、紧簧、藏针的手法；墨霆也曾替这个话多的伞商收拾过漏雨的机关伞。旧交只到手艺与几顿热饭，将去未还并不知道雷夜异变的全貌，因此能在云坪辨认机关师，却不能凭旧情直接唤醒巨兽里的全部意识。"),
		_r("r_c021_c013", "c021", "c013", "入卷后相识", "醒卷初遇 · 争路同心", 1,
			"冷红绫醒卷后最先遇见定山。她主张循最短的墨痕直取封轴，他坚持先替被墨缚的山民解开脚下封线。两人争过一回，也并肩守过一次退路：她发现他并非迂缓，他也看见她每一次冒险都在替别人留门。此后她负责找出缝隙，他负责让缝隙不致合拢。"),
		_r("r_c021_c023", "c021", "c023", "入卷后相识", "墨枝失控 · 刃下留人", 2,
			"白疏影入卷时，废剑与梅枝被残页误写成一片带毒墨林。冷红绫没有把她当作新守关者，而是沿枝势找出真正收紧的封线；定山挡住倒下的墨干，让她亲自削去认错主人的那一笔。三人由此相识，白疏影也第一次不必靠连败七场来证明自己的剑路有资格存在。"),
		_r("r_c023_z000", "c023", "z000", "入卷后相识", "听剑辨名 · 不问师承", 3,
			"白疏影从墨枝的杂音里听出另一种极轻的剑鸣，循声找到守在无字残碑前的洛惊鸿。她没有报剑庐，也没有问对方门派，只递出一枝软剑请洛惊鸿听。洛惊鸿听出鞭击与前刺同属一个人的呼吸，认下这条不合正统的剑路；白疏影则替她守住碑上尚未显出的落款。"),
		_r("r_c013_z002", "c013", "z002", "入卷后相识", "魔音误会 · 先辨人心", 4,
			"苏挽音初醒时以曲声抵住追来的墨兵，附近的刀客却因癫狂彼此攻击，众人一度把她当作操弄残页的乐师。定山不受外物牵心，听出曲中恨意指向旧宫而非眼前人，便放下狼牙棒请她弹完一曲。曲终后她亲自解开误伤者的癫狂，定山才为她让开通往同伴的路。"),
		_r("r_z002_z003", "z002", "z003", "入卷后相识", "曲尽闻伞 · 热汤为约", 5,
